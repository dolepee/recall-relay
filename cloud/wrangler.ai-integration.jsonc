{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "recall-relay-ai-integration",
  "main": "integration-ai-worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {"name": "WORKSPACES", "class_name": "RecallWorkspace"},
      {"name": "BUDGET", "class_name": "UsageBudget"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RecallWorkspace", "UsageBudget"]}],
  "vars": {
    "AI_ENABLED": true,
    "PUBLIC_ORIGINS": ["https://recall-relay.test"]
  },
  "observability": {"enabled": false}
}
