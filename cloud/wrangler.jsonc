{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "recall-relay-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings": [
    {"name":"WORKSPACES","class_name":"RecallWorkspace"},
    {"name":"BUDGET","class_name":"UsageBudget"}
  ]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["RecallWorkspace","UsageBudget"]}],
  "ai": {"binding":"AI"},
  "vars": {
    "AI_ENABLED": true,
    "PUBLIC_ORIGINS": ["https://recall-relay.dolepee.com","https://recall-relay.pages.dev","http://127.0.0.1:8787"]
  },
  "observability": {"enabled":false},
  "dev": {"ip":"127.0.0.1","port":8787}
}
